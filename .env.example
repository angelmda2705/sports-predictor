# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copia a `.env` y rellena.
# NUNCA pongas secretos reales aquí ni en el frontend. Este archivo SÍ se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# --- Entorno ---
APP_ENV=development            # development | test | production

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=sports
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=sports_predictor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sports:change_me_local_only@localhost:5432/sports_predictor

# --- Redis (caché + rate limit) ---
REDIS_URL=redis://localhost:6379/0

# --- Almacenamiento S3 / MinIO (datasets, artefactos, modelos) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_local_only
S3_BUCKET=sports-predictor

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Seguridad / Auth ---
JWT_SECRET=change_me_use_a_long_random_value
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
PASSWORD_HASH_SCHEME=argon2id

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Proveedor de PAGO: API-Football (api-sports.io) ---
# Aporta ALINEACIONES y LESIONES (lo que las fuentes abiertas no tienen).
# 1) Crea cuenta en https://dashboard.api-football.com/ y elige un plan.
# 2) Pega tu API key abajo (es SECRETA; el archivo .env NO se versiona).
# 3) Reinicia el backend y verifica en GET http://localhost:8000/providers/status
# API_FOOTBALL_KEY=tu_api_key_aqui

# --- Otros proveedores (opcionales) ---
# FOOTBALL_DATA_API_KEY=
# THE_ODDS_API_KEY=
# (nflverse y Open-Meteo no requieren clave)
